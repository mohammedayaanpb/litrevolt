# Packaged LitRevolt reads separate provider keys from the OS credential vault.
# These optional process environment variables override that provider's stored key.
# LitRevolt does not automatically load this file; inject values when launching it.
# Choose the active provider and model in Settings; keys never select a provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
KIMI_API_KEY=
# MOONSHOT_API_KEY is also accepted when KIMI_API_KEY is unset.
GEMINI_API_KEY=
